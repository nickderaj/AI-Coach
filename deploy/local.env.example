# Host-specific deployment settings. Copy to deploy/local.env (git-ignored) and
# replace every value; never commit the real file. Plain KEY=VALUE lines only:
# no quotes, no shell expansion. Validated by `python -m trainer.deploy render`.

# Unprivileged system user the services run as (created by install.sh).
TRAINER_USER=trainer

# The only directory the services may write: database, backups.
TRAINER_DATA_DIR=/srv/hermes-trainer

# Root-owned install location for the virtualenv.
TRAINER_PREFIX=/opt/hermes-trainer

# Loopback address the API binds to; tailscale serve publishes it on 443.
TRAINER_BIND_HOST=127.0.0.1
TRAINER_BIND_PORT=8000

# Nightly database backups to keep.
TRAINER_BACKUP_KEEP=14

# The only Tailscale login allowed to use the app (tailscale serve sends it with
# every request from a user-owned device). Find yours with `tailscale status`.
TRAINER_OWNER_LOGIN=owner@example.com

# Loopback port of the coach's Hermes gateway (its API server). Only the API
# talks to it; it is never published with tailscale serve.
TRAINER_HERMES_PORT=8642

# The model provider: an OpenAI-compatible endpoint (HTTPS) and the model id.
# Its API key is not here: sudo ./deploy/hermes-secrets.sh stores it root-only.
TRAINER_MODEL_URL=https://api.example.com/v1
TRAINER_MODEL=model-id

# Who the push services (Apple, Google, Mozilla) can contact about this
# server's notifications: a mailto: address or an HTTPS page. It is sent, signed,
# with every push. The VAPID keys are not here: sudo ./deploy/push-secrets.sh
# makes them root-only.
TRAINER_PUSH_CONTACT=mailto:owner@example.com

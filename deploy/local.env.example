# Host-specific deployment settings. Copy to deploy/local.env (git-ignored) and
# replace every value; never commit the real file. Plain KEY=VALUE lines only:
# no quotes, no shell expansion. Validated by `python -m trainer.deploy render`.

# Unprivileged system user the services run as (created by install.sh).
TRAINER_USER=trainer

# The only directory the services may write: database, backups.
TRAINER_DATA_DIR=/srv/hermes-trainer

# Root-owned install location for the virtualenv.
TRAINER_PREFIX=/opt/hermes-trainer

# Loopback address the API binds to; tailscale serve publishes it on 443.
TRAINER_BIND_HOST=127.0.0.1
TRAINER_BIND_PORT=8000

# Nightly database backups to keep.
TRAINER_BACKUP_KEEP=14

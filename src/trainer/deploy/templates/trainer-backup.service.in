[Unit]
Description=hermes-trainer database backup
Documentation=https://github.com/nickderaj/hermes-trainer

[Service]
Type=oneshot
User=${user}
Group=${user}
ExecStart=${prefix}/venv/bin/python -m trainer.deploy backup --data-dir ${data_dir} --keep ${backup_keep}
UMask=0077

ReadWritePaths=${data_dir}
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX

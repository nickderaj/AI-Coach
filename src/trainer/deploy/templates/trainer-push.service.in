[Unit]
Description=hermes-trainer push sender
Documentation=https://github.com/nickderaj/hermes-trainer
Wants=network-online.target trainer-api.service
# The API migrates the database the sender reads.
After=network-online.target trainer-api.service

[Service]
Type=exec
User=${user}
Group=${user}
Environment=TRAINER_DATA_DIR=${data_dir}
Environment=TRAINER_PUSH_CONTACT=${push_contact}
# Root-only (deploy/push-secrets.sh): the VAPID private key that signs pushes.
# Without it the unit does not start.
EnvironmentFile=${secrets_dir}/push.env
ExecStart=${prefix}/venv/bin/python -m trainer.push serve
Restart=on-failure
RestartSec=10
UMask=0077

# Code is root-owned and read-only; the data directory is the only writable path.
ReadWritePaths=${data_dir}
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The push services are on the internet, so this is the one unit of the app's
# own with a route out; nothing here listens. Everything nearer is refused:
# loopback (the API and the coach), the LAN and the tailnet. The resolvers in
# /etc/resolv.conf are allowed by a drop-in install.sh writes (resolvers.conf).
IPAddressDeny=${push_denied}

[Install]
WantedBy=multi-user.target
